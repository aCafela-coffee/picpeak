# Frontend-only overlay. Runtime, backend, dependencies, environment, volume,
# healthcheck, entrypoint and command are inherited from this exact official AIO.
# Source: ec7b22354fd6b5a66aec9e2a965e22fbcf7334f2 (see aio-baseline.json).
FROM --platform=$BUILDPLATFORM node:22-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps
COPY frontend/ .
RUN npm run build

FROM ghcr.io/picpeak/picpeak/aio@sha256:efd3fa3473e6ac6f518fdead86c43deaa3eca5ce28abec22928e8e2f6cdca4bc
ARG VCS_REF
LABEL org.opencontainers.image.source="https://github.com/aCafela-coffee/picpeak" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.description="PicPeak Korean screen translations; official backend unchanged" \
      io.picpeak.upstream.commit="ec7b22354fd6b5a66aec9e2a965e22fbcf7334f2" \
      io.picpeak.upstream.image="sha256:efd3fa3473e6ac6f518fdead86c43deaa3eca5ce28abec22928e8e2f6cdca4bc"
# Remove old hashed assets too; the overlay contains only the new frontend.
RUN rm -rf /app/frontend/dist
COPY --from=frontend-builder --chown=nodejs:nodejs /app/dist /app/frontend/dist
